PKG_MANAGER="Gradle"
CMD_INSTALL=""
CMD_DEV="./gradlew bootRun"
CMD_TEST="./gradlew test"
CMD_LINT="./gradlew spotlessCheck"
CMD_TYPECHECK="./gradlew classes"
CMD_FORMAT="./gradlew spotlessApply"
CMD_FORMAT_CHECK="./gradlew spotlessCheck"
CMD_BUILD="./gradlew build -x test"
ENFORCEMENT_FILES='`build.gradle.kts` (Spotless + ktlint) and `.github/workflows/ci.yml`'
ALLOW_CMDS=$'"Bash(./gradlew test*)",\n      "Bash(./gradlew build*)",\n      "Bash(./gradlew spotless*)",\n      "Bash(./gradlew classes*)",'
