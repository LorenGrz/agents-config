# Sourced by init.sh. Kotlin supports Gradle only; commands live in @gradle/stack.env.
RUNTIME=jvm
LINT_DESC='Check formatting with Spotless (ktlint)'
LINT_NOTE=''
LANG_STANDARD='- **Kotlin**: immutable `val` and data classes by default, null-safety instead of `!!`, constructor injection, Bean Validation at the controller boundary, no business logic in controllers or repositories.'
LINT_HOOK_DESC='Spotless on every edited `.kt`/`.kts` file (formats it in place)'
SKIP_COMMON=".prettierignore"
