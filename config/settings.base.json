{
  "permissions": {
    "allow": [
      "Bash(aws * describe-*)",
      "Bash(aws * list-*)",
      "Bash(aws * get-*)",
      "Bash(aws * lookup-*)",
      "Bash(aws s3 ls*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "Bash(identify *)",
      "Bash(docker compose ps*)",
      "Bash(journalctl *)",
      "mcp__claude-in-chrome__find",
      "mcp__claude_ai_Supabase__get_advisors",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude_ai_Supabase__list_migrations",
      "Bash(systemctl is-active *)",
      "Bash(pnpm -v)",
      "Bash(*gemini-delegate.sh *)"
    ],
    "ask": [
      "Bash(aws * delete-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws * release-*)",
      "Bash(aws * detach-*)",
      "Bash(aws * remove-*)",
      "Bash(aws * put-*)",
      "Bash(aws * create-*)",
      "Bash(aws * update-*)",
      "Bash(aws * attach-*)",
      "Bash(aws * modify-*)",
      "Bash(aws * stop-*)",
      "Bash(aws * reboot-*)",
      "Bash(aws s3 rm*)",
      "Bash(aws s3 rb*)",
      "Bash(aws s3 cp*)",
      "Bash(aws s3 mv*)",
      "Bash(aws s3 sync*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_create_conversation",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas",
      "mcp__claude_ai_Slack__slack_add_list_record",
      "mcp__claude_ai_Slack__slack_update_list_record",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Calendar__respond_to_event",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__claude_ai_Google_Drive__update_file",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__claude_ai_Atlassian_Rovo__createJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__editJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__transitionJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__addWorklogToJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__createIssueLink",
      "mcp__claude_ai_Atlassian_Rovo__createConfluencePage",
      "mcp__claude_ai_Atlassian_Rovo__updateConfluencePage",
      "mcp__claude_ai_GitHub__merge_pull_request",
      "mcp__claude_ai_GitHub__create_pull_request",
      "mcp__claude_ai_GitHub__push_files",
      "mcp__claude_ai_GitHub__create_or_update_file",
      "mcp__claude_ai_GitHub__delete_file",
      "mcp__claude_ai_GitHub__create_repository",
      "mcp__claude_ai_GitHub__delete_repository",
      "mcp__claude_ai_GitHub__issue_write",
      "mcp__claude_ai_GitHub__add_issue_comment",
      "mcp__claude_ai_GitHub__pull_request_review_write",
      "mcp__claude_ai_GitHub__fork_repository",
      "mcp__obsidian__delete_note",
      "mcp__obsidian__move_note",
      "mcp__obsidian__move_file"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-omarchy.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/scout-readonly.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rtk.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/critical-reasoning.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__claude_ai_GitHub__.*|mcp__claude_ai_Slack__.*|mcp__claude_ai_Atlassian_Rovo__.*|mcp__claude_ai_Gmail__.*|mcp__claude_ai_Google_.*|mcp__obsidian__.*|mcp__notebooklm__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/intent-router.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format-file.sh",
            "statusMessage": "formatting"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-git-status.sh"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/log-instructions.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/critical-reasoning.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/intent-router.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/statusline.sh",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "superpowers@superpowers-marketplace": true,
    "playwright@anthropic-plugin-directory": false,
    "skill-creator@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": false,
    "paste-preview@paste-preview": true,
    "mattpocock-skills@mattpocock": true,
    "claudex-loop@claudex-loop": true,
    "codex@openai-codex": true,
    "claude-obsidian@agricidaniel-claude-obsidian": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "paste-preview": {
      "source": {
        "source": "github",
        "repo": "alan890104/claude-code-paste-preview"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "claudex-loop": {
      "source": {
        "source": "github",
        "repo": "chaseai-yt/claudex-loop"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "agricidaniel-claude-obsidian": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-obsidian"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "multica-ai/andrej-karpathy-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "theme": "dark",
  "env": {
    "PONYTAIL_DEFAULT_MODE": "off",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1"
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": false
      }
    }
  }
}
