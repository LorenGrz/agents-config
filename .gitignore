# Skills linked in from other repos or the system (omarchy, omarchy-app,
# diagnose-crash, superwhisper) — symlinks recreated per machine, never tracked.
/skills/external/

# Local git metadata when this tree is also the working hub
/.claude

# Private organizations: each one is its own git repo, never tracked here
/organizations/*
!/organizations/README.md
!/organizations/_template/

# Skill eval output
evals/results/

# Python build output
__pycache__/
*.pyc
