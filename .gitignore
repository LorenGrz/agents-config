# Skills linked in from other repos — tracked in their own source, not here.
# (These paths exist as symlinks in ~/.agents/skills and resolve at runtime.)
# AWS skills (cost-optimizer, iam-least-privilege, lambda-patterns, sam-deploy,
# serverless-scanner) moved into aws/ via git subtree — they are tracked here now.
/omarchy
/diagnose-crash
/apexlang
/omarchy-app

# Local git metadata when this tree is also the working hub
/.claude

# Private organizations: each one is its own git repo, never tracked here
/organizations/*
!/organizations/README.md
!/organizations/_template/

# Skill eval output
evals/results/

# Python build output
__pycache__/
*.pyc
