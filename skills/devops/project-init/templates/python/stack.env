# Sourced by init.sh (NAME and DIR are already set). uv-managed Python project.
RUNTIME=python
PKG_MANAGER="uv"
PY_PACKAGE="$(basename "$DIR" | tr '[:upper:]-' '[:lower:]_')"
CMD_INSTALL="uv sync --frozen"
CMD_DEV="uv run $(basename "$DIR")"
CMD_TEST="uv run pytest"
CMD_LINT="uv run ruff check ."
CMD_TYPECHECK="uv run mypy ."
CMD_FORMAT="uv run ruff format ."
CMD_FORMAT_CHECK="uv run ruff format --check ."
CMD_BUILD="uv build"
LINT_DESC='Lint with ruff'
LINT_NOTE=''
ENFORCEMENT_FILES='`pyproject.toml` (ruff, mypy, pytest) and `.github/workflows/ci.yml`'
LANG_STANDARD='- **Python**: full type hints (`mypy --strict`), Pydantic or dataclasses at the boundaries, no bare `except`, no mutable default arguments. Deeper: `.claude/rules/python.md`.'
LINT_HOOK_DESC='ruff on every edited `.py` file'
ALLOW_CMDS=$'"Bash(uv run pytest*)",\n      "Bash(uv run ruff *)",\n      "Bash(uv run mypy *)",\n      "Bash(uv sync*)",'
SKIP_COMMON=".prettierignore"
