PKG_MANAGER="Maven"
CMD_INSTALL=""
CMD_DEV="./mvnw spring-boot:run"
CMD_TEST="./mvnw -B test"
CMD_LINT="./mvnw -B -q spotless:check"
CMD_TYPECHECK="./mvnw -B -q compile"
CMD_FORMAT="./mvnw -B -q spotless:apply"
CMD_FORMAT_CHECK="./mvnw -B -q spotless:check"
CMD_BUILD="./mvnw -B -q package -DskipTests"
ENFORCEMENT_FILES='`pom.xml` (Spotless) and `.github/workflows/ci.yml`'
ALLOW_CMDS=$'"Bash(./mvnw test*)",\n      "Bash(./mvnw verify*)",\n      "Bash(./mvnw *spotless:*)",\n      "Bash(./mvnw *compile*)",'
