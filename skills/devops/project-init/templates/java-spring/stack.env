# Sourced by init.sh. The build-tool commands live in @maven/ and @gradle/ stack.env.
RUNTIME=jvm
LINT_DESC='Check formatting with Spotless'
LINT_NOTE=''
LANG_STANDARD='- **Java**: Java 21, constructor injection only, `record`s for DTOs and value objects, Bean Validation at the controller boundary, no business logic in controllers or repositories.'
LINT_HOOK_DESC='Spotless on every edited `.java` file (formats it in place)'
SKIP_COMMON=".prettierignore"
